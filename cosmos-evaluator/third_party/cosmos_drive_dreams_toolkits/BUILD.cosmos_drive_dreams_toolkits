load("@rules_python//python:defs.bzl", "py_library")

# The .dist-info synthesized by the `dist_info_*` attrs on this archive's `http_archive.archive(...)` tag (see
# ../../MODULE.bazel) only reaches a runfiles tree — and therefore an image layer, and therefore an SBOM — if a target
# carries it as data. Every py_library below does, so the metadata follows the code no matter which target a consumer
# depends on.
filegroup(
    name = "dist_info",
    srcs = glob(["third_party/cosmos_drive_dreams_toolkits/cosmos_drive_dreams_toolkits-*.dist-info/**"]),
    visibility = ["//visibility:public"],
)

py_library(
    name = "camera_base",
    srcs = ["third_party/cosmos_drive_dreams_toolkits/utils/camera/base.py"],
    data = [":dist_info"],
    imports = ["third_party/cosmos_drive_dreams_toolkits"],
    visibility = ["//visibility:public"],
    deps = [
        ":pcd_utils",
        "@opencv_python_headless",
        "@pypi//numpy",
        "@pypi//shapely",
        "@pypi//torch",
    ],
)

py_library(
    name = "camera_ftheta",
    srcs = ["third_party/cosmos_drive_dreams_toolkits/utils/camera/ftheta.py"],
    data = [":dist_info"],
    imports = ["third_party/cosmos_drive_dreams_toolkits"],
    visibility = ["//visibility:public"],
    deps = [
        ":camera_base",
        "@pypi//numpy",
        "@pypi//scipy",
        "@pypi//torch",
    ],
)

filegroup(
    name = "config",
    srcs = [
        "third_party/cosmos_drive_dreams_toolkits/config/world_scenario_color_config.json",
        "third_party/cosmos_drive_dreams_toolkits/config/world_scenario_laneline_config.json",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "pcd_utils",
    srcs = ["third_party/cosmos_drive_dreams_toolkits/utils/pcd_utils.py"],
    data = [":dist_info"],
    imports = ["third_party/cosmos_drive_dreams_toolkits"],
    deps = [
        "@pypi//einops",
        "@pypi//numpy",
        "@pypi//scipy",
        "@pypi//shapely",
        "@pypi//torch",
        "@pypi//trimesh",
    ],
)

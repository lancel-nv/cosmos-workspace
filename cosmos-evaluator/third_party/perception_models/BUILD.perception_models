load("@rules_python//python:defs.bzl", "py_library")

# The .dist-info synthesized by the `dist_info_*` attrs on this archive's `http_archive.archive(...)` tag (see
# ../../MODULE.bazel) only reaches a runfiles tree — and therefore an image layer, and therefore an SBOM — if a target
# carries it as data.
filegroup(
    name = "dist_info",
    srcs = glob(["third_party/perception_models/perception_models-*.dist-info/**"]),
    visibility = ["//visibility:public"],
)

py_library(
    name = "vision_encoder",
    srcs = [
        "third_party/perception_models/core/vision_encoder/config.py",
        "third_party/perception_models/core/vision_encoder/pe.py",
        "third_party/perception_models/core/vision_encoder/rope.py",
    ],
    data = [":dist_info"],
    imports = ["third_party/perception_models"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//einops",
        "@pypi//numpy",
        "@pypi//timm",
        "@pypi//torch",
    ],
)

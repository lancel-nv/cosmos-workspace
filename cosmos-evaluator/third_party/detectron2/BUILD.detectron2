load("@rules_python//python:defs.bzl", "py_library")

# The .dist-info synthesized by the `dist_info_*` attrs on this archive's `http_archive.archive(...)` tag (see
# ../../MODULE.bazel) only reaches a runfiles tree — and therefore an image layer, and therefore an SBOM — if a target
# carries it as data. Every py_library below does, so the metadata follows the code no matter which target a consumer
# depends on.
filegroup(
    name = "dist_info",
    srcs = glob(["third_party/detectron2-*.dist-info/**"]),
    visibility = ["//visibility:public"],
)

py_library(
    name = "utils",
    srcs = [
        "third_party/detectron2/utils/file_io.py",
        "third_party/detectron2/utils/registry.py",
    ],
    data = [":dist_info"],
    imports = ["third_party"],
)

py_library(
    name = "config",
    srcs = [
        "third_party/detectron2/config/instantiate.py",
        "third_party/detectron2/config/lazy.py",
    ],
    data = [":dist_info"],
    imports = ["third_party"],
    visibility = ["//visibility:public"],
    deps = [
        ":utils",
        "@pypi//cloudpickle",
        "@pypi//fvcore",
        "@pypi//omegaconf",
        "@pypi//pyyaml",
    ],
)

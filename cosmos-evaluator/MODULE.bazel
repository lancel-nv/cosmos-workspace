# Bazel module definition for Cosmos Evaluator.
module(
    name = "cosmos_eval",
    version = "1.0",
)

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")  # Tar/mtree utilities for OCI image layer splitting
bazel_dep(name = "aspect_rules_lint", version = "2.6.0")  # Formatting/linting rules (v2.7.x has a bug in Ruff aspect)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2")  # Buildifier for formatting Bazel files
bazel_dep(name = "gazelle", version = "0.47.0", repo_name = "bazel_gazelle")
bazel_dep(name = "rules_python_gazelle_plugin", version = "2.0.3")
bazel_dep(name = "platforms", version = "1.0.0")  # @platforms//os constraints (target_compatible_with on vendored wheel)
bazel_dep(name = "rules_distroless", version = "0.8.0")  # Bazel-native Debian package management for OCI images
bazel_dep(name = "rules_multirun", version = "0.14.0")  # Multirun for running targets concurrently
bazel_dep(name = "rules_mypy", version = "0.41.0")  # Mypy for type checking
bazel_dep(name = "rules_oci", version = "2.3.0")  # Open Containers Initiative rules
bazel_dep(name = "rules_pkg", version = "1.2.0")  # For creating tar archives
bazel_dep(name = "rules_python", version = "2.0.3")  # Python rules for building and testing
bazel_dep(name = "rules_shell", version = "0.8.0")  # Shell rules for building and testing

# Python toolchain.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    configure_coverage_tool = True,
    python_version = "3.13",
)

# Pin the 3.13 line to CPython 3.13.16. rules_python resolves 3.13 to 3.13.13, which lacks the fixes for CVE-2026-6100
# (use-after-free in the lzma/bz2/zlib decompressors under memory pressure), CVE-2026-11940 and CVE-2026-82049 (link
# bypasses of tarfile's data/tar extraction filters), CVE-2026-11972 (unbounded seeking in streaming-mode tarfile),
# CVE-2026-19445 (ssl crash when an SNI callback switches contexts) and CVE-2026-15806 (urllib.request credentials
# shared across URL schemes). Its bundled runtime manifest has no 3.13 build newer than 3.13.13, so the URLs and digests
# below are stated explicitly and point at the 20261003 python-build-standalone release. single_version_override
# registers 3.13.16 and the minor_mapping override repoints every `python_version = "3.13"` reference (toolchain,
# pip.parse) at it. The SHA256s are those of the `install_only` (non-stripped) tarballs, the variant rules_python's
# get_release_info selects (build=install_only, ext=tar.gz) for these platforms.
# TODO(kudesai): Drop both blocks once a rules_python release maps 3.13 to >= 3.13.16 on its own.
python.single_version_override(
    python_version = "3.13.16",
    sha256 = {
        "aarch64-apple-darwin": "d8975d7df4f08f7b1c7aafcdfacbddcec3d366415f2c1a72b2466b6850815933",
        "aarch64-unknown-linux-gnu": "6477121f22904963a066ac8ff89983baae781510815590e894daa3c11ce86652",
        "x86_64-apple-darwin": "8e9cb087305bfb8969f68a905f79f41469d4aa5220c1aa71ada7fc9953bdba0f",
        "x86_64-unknown-linux-gnu": "0a0272910b10417c659a9312fb3f2d7a6d774da7bd510999be7a3ba83273dc1f",
    },
    urls = ["20261003/cpython-{python_version}+20261003-{platform}-{build}.{ext}"],
)
python.override(
    minor_mapping = {"3.13": "3.13.16"},
)

# Python pip extension for resolving requirements.txt from requirements.in.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
use_repo(pip, "pypi")

# Dev-tagged extension for resolving requirements.txt from requirements.in in consumer modules
pip_dev = use_extension("@rules_python//python/extensions:pip.bzl", "pip", dev_dependency = True)
pip_dev.parse(
    timeout = 1800,  # 30 minutes
    # Register the PyTorch cu128 index with the bzlmod SimpleAPI resolver so it can match the +cu128 wheel hashes
    # in requirements.txt. Without this, rules_python only queries pypi.org/simple and warns on every cu128 hash.
    experimental_extra_index_urls = ["https://download.pytorch.org/whl/cu128"],
    extra_pip_args = [
        "--retries=3",
        "--extra-index-url=https://download.pytorch.org/whl/cu128",
    ],
    hub_name = "pypi",
    python_version = "3.13",
    requirements_lock = "//:requirements.txt",
)

# Improve mypy's type checking with available type stubs.
types = use_extension("@rules_mypy//mypy:types.bzl", "types")
use_repo(types, "pip_types")

# Dev-tagged extension for resolving requirements.txt from requirements.in in consumer modules
types_dev = use_extension("@rules_mypy//mypy:types.bzl", "types", dev_dependency = True)
types_dev.requirements(
    name = "pip_types",
    pip_requirements = "@pypi//:requirements.bzl",
    requirements_txt = "//:requirements.txt",
)

# Custom http_archive extension. Wraps Bazel's stock http_archive with three extra capabilities: the netrc attribute is
# resolved at fetch time, expanding `~` to the user's home directory (needed for archives whose download URL requires
# netrc-based auth from a credentials file under $HOME); `patches` fixes up the extracted tree in place; and the
# `dist_info_*` attributes synthesize a Python `.dist-info` directory so the vendored subset carries a name, version,
# and license that `importlib.metadata` and SBOM scanners can both read. Consumer modules that want to add their own
# archives can `use_extension("//third_party:http_archive.bzl", "http_archive")` and contribute their own
# `http_archive.archive(...)` tags; bzlmod merges all tags into a single extension run.
http_archive = use_extension("//third_party:http_archive.bzl", "http_archive")
http_archive.archive(
    name = "cosmos_drive_dreams_toolkits",
    add_prefix = "third_party/cosmos_drive_dreams_toolkits",
    build_file = "//third_party/cosmos_drive_dreams_toolkits:BUILD.cosmos_drive_dreams_toolkits",
    dist_info_homepage = "https://github.com/nv-tlabs/Cosmos-Drive-Dreams",
    dist_info_license = "Apache-2.0",
    dist_info_license_files = ["//third_party/cosmos_drive_dreams_toolkits:LICENSE"],
    dist_info_name = "cosmos-drive-dreams-toolkits",
    dist_info_root = "third_party/cosmos_drive_dreams_toolkits",
    dist_info_summary = "Camera models and geometry utilities from the Cosmos-Drive-Dreams toolkits",
    dist_info_version = "0+908ba8f6",
    integrity = "sha256-FpKCpKK8jgxkocXZQCF1q7oSKcS1JqmacmY5dAGShZQ=",
    strip_prefix = "Cosmos-Drive-Dreams-908ba8f65463a222e46127222d669e40b778986d/cosmos-drive-dreams-toolkits",
    url = "https://github.com/nv-tlabs/Cosmos-Drive-Dreams/archive/908ba8f65463a222e46127222d669e40b778986d.zip",
)
http_archive.archive(
    name = "detectron2",
    add_prefix = "third_party/detectron2",
    build_file = "//third_party/detectron2:BUILD.detectron2",
    dist_info_homepage = "https://github.com/facebookresearch/detectron2",
    dist_info_license = "Apache-2.0",
    dist_info_license_files = ["//third_party/detectron2:LICENSE"],
    dist_info_name = "detectron2",
    dist_info_root = "third_party",
    dist_info_summary = "Lazy/instantiate config helpers and file_io + registry utilities from Detectron2",
    dist_info_version = "0.6+a1ce2f95",
    integrity = "sha256-/XHLB2/1MTPjgk0c/PwSzWR4TT1rFBPRURBdQG9+Z2I=",
    strip_prefix = "detectron2-a1ce2f956a1d2212ad672e3c47d53405c2fe4312/detectron2",
    url = "https://github.com/facebookresearch/detectron2/archive/a1ce2f956a1d2212ad672e3c47d53405c2fe4312.zip",
)
http_archive.archive(
    name = "perception_models",

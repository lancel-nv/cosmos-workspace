### Images for Tests ###
# Ryuk, the reaper container testcontainers starts to remove a test session's containers once the session ends. Tests
# load it from runfiles under testcontainers' default tag, so the library finds it locally and never pulls it. Tracks
# testcontainers/ryuk at the version the pinned testcontainers release requests. Fetched through Google's Docker Hub
# mirror, which serves cached images anonymously without Docker Hub's unauthenticated pull-rate limit.
oci.pull(
    name = "ryuk_image",
    digest = "sha256:bf3f74a47dee0acda89aba4b2fc9c7fdcf994a084db02a2d06566f07baae022e",
    image = "mirror.gcr.io/testcontainers/ryuk:0.8.1",
    platforms = ["linux/amd64"],
)
use_repo(
    oci,
    "ryuk_image",
    "ryuk_image_linux_amd64",
)

### Debian Package Layers for Microservice Images ###
# Resolves and downloads .deb packages at build time, producing tar layers that are added to OCI images via rules_oci.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    name = "objects_packages",
    lock = "//services/objects/single_view:packages.lock.json",
    manifest = "//services/objects/single_view:packages.yaml",
    mergedusr = True,
)
use_repo(apt, "objects_packages")

apt.install(
    name = "physical_plausibility_packages",
    lock = "//services/physical_plausibility:packages.lock.json",
    manifest = "//services/physical_plausibility:packages.yaml",
    mergedusr = True,
)
use_repo(apt, "physical_plausibility_packages")

apt.install(
    name = "attribute_verification_packages",
    lock = "//services/attribute_verification:packages.lock.json",
    manifest = "//services/attribute_verification:packages.yaml",
    mergedusr = True,
    resolve_transitive = True,
)
use_repo(apt, "attribute_verification_packages")

### Pre-downloaded .deb packages for GPU microservice images ###
# These packages come from NVIDIA's flat apt repo which rules_distroless cannot resolve. Pre-downloading the .deb files
# eliminates the need for apt-get update/install at container startup, saving ~2 minutes of network I/O per launch.
# They are bundled into the //services:cuda_debs_layer tar and installed via dpkg -i in each GPU image's startup script.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "cuda_cupti_12_8_deb",
    downloaded_file_path = "cuda-cupti-12-8.deb",
    sha256 = "cc73a4e090945b020fb0caa65830b9d12421d5cf802db5f977b1a3d7a78e9a68",
    urls = ["https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/x86_64/cuda-cupti-12-8_12.8.90-1_amd64.deb"],
)

http_file(

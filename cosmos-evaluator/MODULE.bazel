oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "ubuntu_22_04_image",
    digest = "sha256:55caea0b2381efa9f672e20fc3e19b42bb74a86814e9c3ea25c7043d21428aec",
    image = "nvcr.io/nvidia/base/ubuntu:jammy-20260810",
    platforms = ["linux/amd64"],

# Custom local_wheel extension. Extracts a committed local wheel (tracked via Git LFS) into its own repo and overlays
# a hand-written BUILD file — the wheel analog of the http_archive extension above. Used to vendor a custom-built
# opencv-python-headless wheel compiled WITH_FFMPEG=OFF (strict LGPL: no bundled FFmpeg) and WITH_IPP=OFF (no Intel IPP,
# whose license is not open source) that cannot come from PyPI.
# See third_party/local_wheel.bzl, third_party/opencv/build_wheel.sh, and third_party/opencv/BUILD.opencv.
local_wheel = use_extension("//third_party:local_wheel.bzl", "local_wheel")
local_wheel.wheel(
    name = "opencv_python_headless",
    src = "//third_party/opencv:opencv_python_headless-4.13.0.92+noffmpeg.noipp-cp313-cp313-manylinux_2_28_x86_64.whl",
    build_file = "//third_party/opencv:BUILD.opencv",
)
use_repo(local_wheel, "opencv_python_headless")

### Base Images for Microservices ###

    dist_info_homepage = "https://github.com/facebookresearch/perception_models",
    dist_info_license = "Apache-2.0",
    dist_info_license_files = ["//third_party/perception_models:LICENSE"],
    dist_info_name = "perception-models",
    dist_info_root = "third_party/perception_models",
    dist_info_summary = "Perception Encoder vision encoder (core/vision_encoder) used by the CWIP model",
